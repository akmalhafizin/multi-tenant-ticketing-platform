# ─── Database ───────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/ticketing"

# ─── Auth ────────────────────────────────────────────────────────
# Secret key for signing JWT tokens (change in production!)
JWT_SECRET="dev-secret-change-in-production"

# ─── Frontend URL ───────────────────────────────────────────────
# Used for invite acceptance links and guest tracking email links
FRONTEND_URL="http://localhost:5173"

# ─── Server ──────────────────────────────────────────────────────
# Port the API server listens on (default: 3001)
PORT=3001

# ─── S3 / MinIO ─────────────────────────────────────────────────
# Endpoint of your S3-compatible storage (MinIO, AWS S3, Cloudflare R2, etc.)
S3_ENDPOINT="http://localhost:9000"
# Bucket name for uploaded files
S3_BUCKET="ticketing"
# Region (required by S3 SDK even for MinIO — use "us-east-1" for most)
S3_REGION="us-east-1"
# Access key / Secret key
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# ─── Optional: Frontend API Base URL ───────────────────────────
# If the frontend is served from a different origin than the API
# (e.g. via Cloudflare Tunnel or separate hosting), uncomment and
# set this. Create it as apps/web/.env, NOT at the root.
# VITE_API_URL="https://your-production-url.com"
